<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="56dp">

        <!-- ── HEADER ──────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="20dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SESSION HISTORY"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:letterSpacing="0.12"
                android:paddingEnd="8dp"/>

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← BACK"
                android:textSize="11sp"
                android:textColor="@color/cyan"
                android:letterSpacing="0.1"
                android:background="@color/cyan_dim"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:onClick="onBackPressed"/>

        </LinearLayout>

        <!-- Cyan scan line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cyan"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERFORMANCE ANALYTICS"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:textColor="@color/cyan"
            android:layout_marginBottom="22dp"/>

        <!-- ── ANALYSIS ───────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_hud"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANALYSIS"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:textColor="@color/cyan"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Total Sessions / Total Likes row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SESSIONS"
                        android:textSize="9sp"
                        android:letterSpacing="0.12"
                        android:textColor="@color/text_muted"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvAnalysisTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL LIKES"
                        android:textSize="9sp"
                        android:letterSpacing="0.12"
                        android:textColor="@color/text_muted"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvAnalysisTotalLikes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/success"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/control_bg"
                android:layout_marginBottom="12dp"/>

            <!-- Avg Success / Avg Observed row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AVG SUCCESS RATE"
                        android:textSize="9sp"
                        android:letterSpacing="0.12"
                        android:textColor="@color/text_muted"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvAnalysisAvgSuccess"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AVG OBSERVED RATE"
                        android:textSize="9sp"
                        android:letterSpacing="0.12"
                        android:textColor="@color/text_muted"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:id="@+id/tvAnalysisAvgObserved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ── RECOMMENDATION ────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_primary"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECOMMENDED CONFIG"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvRecConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvRecReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/btnApplyRec"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="APPLY RECOMMENDATION"
                android:textSize="13sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:textColor="@color/bg_main"
                android:background="@color/primary"
                android:gravity="center"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- ── SESSION LOG ────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SESSION LOG"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:textColor="@color/cyan"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvEmptySessions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No sessions recorded yet.\nStart tapping to build history."
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:lineSpacingExtra="4dp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/sessionLogContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
